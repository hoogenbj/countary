<VBox alignment="CENTER_LEFT" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="hoogenbj.countary.app.AccountsWorksheetController">
    <HBox>
        <ClearableTextField fx:id="searchCriteria" promptText="Enter text to search for">
        </ClearableTextField>
    </HBox>
    <HBox>
        <TableView fx:id="tableView" editable="true" HBox.hgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="nameColumn" minWidth="-Infinity" prefWidth="250.0" text="Name" />
                <TableColumn fx:id="numberColumn" minWidth="-Infinity" prefWidth="150.0" text="Number" />
                <TableColumn fx:id="branchColumn" minWidth="-Infinity" prefWidth="100.0" text="Branch code" />
                <TableColumn fx:id="bankColumn" minWidth="-Infinity" prefWidth="250.0" text="Bank" />
                <TableColumn fx:id="accountBalanceColumn" editable="false" minWidth="-Infinity" style="-fx-alignment: center-right;" prefWidth="100.0" text="Balance" />
                <TableColumn fx:id="statementColumn" prefWidth="250.0" text="Statement type" />
                <TableColumn fx:id="tagColumn" minWidth="-Infinity" prefWidth="50.0" style="-fx-alignment: center;" text="Tag" />
                <TableColumn fx:id="sortColumn" minWidth="-Infinity" prefWidth="250.0" style="-fx-alignment: center;" text="Sorting" />
            </columns>
        </TableView>
    </HBox>
    <HBox VBox.vgrow="ALWAYS">
        <TableView fx:id="budgetTableView" HBox.hgrow="ALWAYS" editable="false">
            <columns>
                <TableColumn fx:id="budgetNameColumn" prefWidth="300.0" text="Budget Name" />
                <TableColumn fx:id="budgetBalanceColumn" prefWidth="100.0" style="-fx-alignment: center-right;" text="Balance" />
                <TableColumn fx:id="kindColumn" prefWidth="150.0" text="Budget Kind" />
            </columns>
        </TableView>
    </HBox>
</VBox>
